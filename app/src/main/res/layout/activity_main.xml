<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E9CA9C">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zamuf_picce_z_francji"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="8dp"
        android:textColor="#600020"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="@string/rozmiar"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        android:textColor="#700030"/>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        android:checkedButton="@id/rozmiar3">


        <RadioButton
            android:id="@+id/rozmiar3"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:padding="10dp"
            android:text="@string/_3cm"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rozmiar8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/_8cm"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rozmiar69"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/_69cm"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rozmiarOstroznie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/_3m"
            android:textSize="18sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dodatki"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup"
        android:padding="4dp"
        android:textSize="25sp"
        android:textColor="#700030"/>

    <CheckBox
        android:id="@+id/salame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salame"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <CheckBox
        android:id="@+id/mielonka"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mielonka"
        android:padding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/salame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <CheckBox
        android:id="@+id/pieczarki"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pieczarki"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/salame"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <CheckBox
        android:id="@+id/winogron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/winogrono"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/salame" />

    <CheckBox
        android:id="@+id/kukurydza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kukurydz"
        android:padding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/winogron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mielonka" />

    <CheckBox
        android:id="@+id/doritos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/doritos"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/winogron"
        app:layout_constraintTop_toBottomOf="@+id/pieczarki" />

    <CheckBox
        android:id="@+id/ananas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ananas"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/winogron" />

    <CheckBox
        android:id="@+id/kurczak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kurczak"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ananas"
        app:layout_constraintTop_toBottomOf="@+id/doritos" />

    <CheckBox
        android:id="@+id/brokul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/brokulka"
        android:padding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/ananas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kukurydza" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ilosc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ananas"
        android:padding="4dp"
        android:textSize="25sp"
        android:textColor="#700030"/>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4"
        android:padding="4dp"/>

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adres"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar"
        android:padding="4dp"
        android:textSize="25sp"
        android:textColor="#700030"/>

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:padding="4dp"
        android:text=""
        android:textColor="#700030"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:text="@string/_0"
        android:textColor="#700030"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/textView7"
            android:entries="@array/deliveries"/>

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rodzaj_dostawy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editText"
            android:padding="4dp"
            android:textSize="25sp"
            android:textColor="#700030"/>

        <Button
            android:id="@+id/zamuf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="#EEDAAC"
            android:padding="4dp"
            android:text="@string/zamuf_pice"
            android:textColor="#700030"
            android:textSize="25sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinner" />

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="25dp"
            android:backgroundTint="#EEDAAC"
            android:padding="4dp"
            android:text="@string/resetuj_form"
            android:textColor="#700030"
            android:textSize="25sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinner" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>